#!/usr/bin/env bash
set -euo pipefail
umask 077

source_file="${SECRETS_SOURCE:-$HOME/.env.local}"
repo="${DOTFILES_DIR:-$HOME/dotfiles}"
target="$repo/zsh/dot-env.local"

command -v ansible-vault >/dev/null || {
  echo "Missing required command: ansible-vault" >&2
  exit 2
}
[[ -f "$source_file" ]] || {
  echo "Missing secrets file: $source_file" >&2
  exit 2
}

mode="$(stat -c '%a' "$source_file")"
[[ "$mode" == "600" ]] || {
  echo "Refusing: $source_file mode is $mode; run chmod 600 first" >&2
  exit 2
}
[[ -d "$repo/.git" && -d "$(dirname "$target")" ]] || {
  echo "Invalid dotfiles repository: $repo" >&2
  exit 2
}

tmp="$(mktemp "$(dirname "$target")/.dot-env.local.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
vault_args=()
if [[ -n "${VAULT_PASSWORD_FILE:-}" ]]; then
  vault_args+=(--vault-password-file "$VAULT_PASSWORD_FILE")
fi

ansible-vault encrypt "${vault_args[@]}" --output "$tmp" "$source_file"
ansible-vault view "${vault_args[@]}" "$tmp" >/dev/null
chmod 0600 "$tmp"
mv -f "$tmp" "$target"
trap - EXIT

echo "Updated encrypted $target from $source_file"
echo "Review and commit it manually; plaintext was not staged."