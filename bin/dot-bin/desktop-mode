#!/usr/bin/env bash
# desktop-mode — restore state recorded by server-mode
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/power-mode"
STATE_FILE="$STATE_DIR/desktop.state"
DRY_RUN=false
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=true
[[ $# -le 1 ]] || {
    printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
    exit 2
}

log() { printf '[desktop] %s\n' "$*"; }
run() {
    if $DRY_RUN; then
        printf '[dry-run]'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

profile=balanced
sddm_active=yes
bluetooth_active=no
if [[ -r "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$STATE_FILE"
else
    log 'No recorded state; safe defaults: balanced + SDDM'
fi

case "$profile" in
    power-saver | balanced | performance) ;;
    *)
        log "Invalid recorded profile '$profile'; using balanced"
        profile=balanced
        ;;
esac

log "Power profile → $profile"
run powerprofilesctl set "$profile"

if [[ "$sddm_active" == yes ]] && ! systemctl is-active --quiet sddm; then
    log 'SDDM → started'
    run sudo systemctl start sddm
else
    log 'SDDM state already correct'
fi

if [[ "$bluetooth_active" == yes ]] && ! systemctl is-active --quiet bluetooth; then
    log 'Bluetooth → started'
    run sudo systemctl start bluetooth
fi

if command -v ddcutil >/dev/null && [[ "$sddm_active" == yes ]]; then
    log 'Monitor → power on'
    run sudo ddcutil setvcp D6 01 || log 'Warning: DDC monitor power-on failed; continuing'
fi

if [[ -e "$STATE_FILE" ]] && ! $DRY_RUN; then
    trash-put "$STATE_FILE"
fi

log 'Preserved: LAN, NetworkManager, Tailscale, Docker, Hermes, OmniRoute'
log 'Desktop mode restored'
